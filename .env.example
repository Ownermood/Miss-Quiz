# ============================================================
# MissQuiz Telegram Bot - MongoDB Edition
# ============================================================

# ── Telegram Bot ─────────────────────────────────────────────
TELEGRAM_TOKEN=your_bot_token_here

# ── Bot Owner ────────────────────────────────────────────────
OWNER_ID=your_telegram_user_id_here
# Optional extra authorized user:
# WIFU_ID=

# ── MongoDB ──────────────────────────────────────────────────
# Local:
MONGODB_URL=mongodb://localhost:27017
# Atlas:
# MONGODB_URL=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=quiz_bot

# ── Flask Session ────────────────────────────────────────────
SESSION_SECRET=your_random_secret_here

# ── Security ─────────────────────────────────────────────────
# Web admin API/panel is DISABLED unless this is set (sent as X-Admin-Key).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=
# Optional: webhook secret. If unset, one is derived from TELEGRAM_TOKEN.
# WEBHOOK_SECRET_TOKEN=
# Telegram Mini App (quiz player). Public HTTPS base that proxies to this Flask app.
# Unset = no "📱 Open in App" button. Example: https://quiz.example.com
# MINI_APP_URL=

# Bot username (without @) for the landing page at / ("Add to group" / "Open the bot" links).
# Unset = those buttons open the community link instead.
# BOT_USERNAME=

# ── Deployment ───────────────────────────────────────────────
MODE=polling
PORT=5000
# WEBHOOK_URL=https://your-domain.com
# RENDER_URL=

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Premium emoji ────────────────────────────────────────────
# 1 = premium (custom) emoji ON. Needs Telegram Premium on the account that created the bot in @BotFather. 0 = normal emoji.
PREMIUM_EMOJI=1

# Broadcasts delete themselves this many hours after sending (Telegram only allows
# deleting messages under 48h old, so max 47.5). 0 = keep broadcasts forever.
# BROADCAST_DELETE_AFTER_H=47

# Group Quiz final result as a Telegram Rich Message (real table). 0 = old plain result.
# RICH_MESSAGES=1
