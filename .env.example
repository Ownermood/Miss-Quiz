# ============================================================
# MissQuiz Telegram Bot - MongoDB Edition
# ============================================================

# ── Telegram Bot ─────────────────────────────────────────────
TELEGRAM_TOKEN=your_bot_token_here

# ── Bot Owner ────────────────────────────────────────────────
OWNER_ID=your_telegram_user_id_here
# Optional extra authorized user:
# WIFU_ID=

# ── MongoDB ──────────────────────────────────────────────────
# Local:
MONGODB_URL=mongodb://localhost:27017
# Atlas:
# MONGODB_URL=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=quiz_bot

# ── Flask Session ────────────────────────────────────────────
SESSION_SECRET=your_random_secret_here

# ── Security ─────────────────────────────────────────────────
# Web admin API/panel is DISABLED unless this is set (sent as X-Admin-Key).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=
# Optional: webhook secret. If unset, one is derived from TELEGRAM_TOKEN.
# WEBHOOK_SECRET_TOKEN=

# ── Deployment ───────────────────────────────────────────────
MODE=polling
PORT=5000
# WEBHOOK_URL=https://your-domain.com
# RENDER_URL=

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Premium emoji ────────────────────────────────────────────
# 1 = use premium (custom) emoji. Works only if the bot owner has Telegram Premium.
PREMIUM_EMOJI=0
